<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
    .NET 10, its assemblies sit in the game folder itself, and one assembly -
    UnityStubs - stands in for everything that was UnityEngine.*Module.dll.
    So this is net10.0 and compiles against that stand-in, which turns a
    Unity member 1.7 does not have into a compile error here instead of a
    type that fails to load there. The 1.6 build is the tag
    rimworld-1.6-final.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The game loads a mod assembly from the mod's own folder: no deps
         file beside it. A package this mod ships has to reach the output. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RimAI.Communication.Personas</AssemblyName>
    <RootNamespace>Ustas.RimAI.Communication.Personas</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldWorkshopDir Condition=" '$(RimWorldWorkshopDir)' == '' ">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>

    <BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Personas\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication.Personas\obj\</BaseIntermediateOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
    <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="../Rimtalk-Persona-Director/**" />
    <Compile Remove="../tests/**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimWorldDir)\Mods\Harmony\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\..\RimAI.Communication\Source\RimAI.Communication.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>


